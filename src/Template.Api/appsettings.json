{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5000"
      }
    }
  },
  "AllowedHosts": "*",
  "DatabaseConfig": {
    "Type": "Postgres",
    // Connection string below is for local development only. In production, inject
    // credentials via environment variables (e.g. POSTGRES_PASSWORD) and never commit
    // real secrets to source control.
    "ConnectionString": "Host=localhost;Port=5432;Database=template;Username=postgres;Password=postgres"
  },
  "JwtConfig": {
    // Secret below is for local development only. In production, inject via environment
    // variables (e.g. JwtConfig__Secret) and never commit real secrets to source control.
    "Issuer": "Template",
    "Audience": "Template",
    "Secret": "dev-secret-must-be-at-least-32-bytes-long!",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  }
}
